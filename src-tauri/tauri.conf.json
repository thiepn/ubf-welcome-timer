{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UBF Köln Timer",
  "version": "1.1.0",
  "identifier": "dev.thiepn.ubfwelcometimer",
  "build": {
    "frontendDist": "../dist/desktop",
    "beforeBuildCommand": "node scripts/build-desktop.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "controller",
        "title": "UBF Köln Timer — Steuerung",
        "url": "control.html",
        "width": 1120,
        "height": 800,
        "minWidth": 760,
        "minHeight": 610,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
